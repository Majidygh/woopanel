msgstr "سفارش %s"

msgid "No downloads available yet."
msgstr "هنوز فایلی برای دانلود ندارید."

msgid "Remaining: %s"
msgstr "باقی‌مانده: %s"

msgid "Expires: %s"
msgstr "انقضا: %s"

msgid "Download"
msgstr "دانلود"

msgid "Edit"
msgstr "ویرایش"

msgid "Close"
msgstr "بستن"

msgid "No address saved yet."
msgstr "هنوز نشانی‌ای ذخیره نشده."

msgid "Select an option"
msgstr "انتخاب کنید"

