msgid "WooPanel"
msgstr "ووپنل"

msgid "WooCommerce is not active. WooPanel needs WooCommerce to display customer data."
msgstr "ووکامرس فعال نیست. ووپنل برای نمایش داده‌های مشتری به ووکامرس نیاز دارد."

msgid "Accent color"
msgstr "رنگ اصلی"

msgid "Used for buttons, links and active states."
msgstr "برای دکمه‌ها، لینک‌ها و حالت‌های فعال به کار می‌رود."

msgid "Royal violet"
msgstr "بنفش شاهانه"

msgid "Persian turquoise"
msgstr "فیروزه‌ی ایرانی"

msgid "Caspian blue"
msgstr "آبی خزر"

msgid "Saffron"
msgstr "زعفران"

msgid "Pomegranate"
msgstr "انار"

msgid "Forest"
msgstr "جنگل"

msgid "Midnight"
msgstr "نیمه‌شب"

msgid "Wine"
msgstr "شرابی"

msgid "One-click palettes. The soft background tint adjusts automatically."
msgstr "پالت‌های آماده با یک کلیک. رنگ ملایم پس‌زمینه خودکار تنظیم می‌شود."

msgid "Accent background"
msgstr "پس‌زمینه‌ی رنگ اصلی"

msgid "Soft background tint for icon chips and hero."
msgstr "رنگ ملایم پس‌زمینه برای آیکون‌ها و بنر خوش‌آمد."

msgid "Layout width"
msgstr "عرض و چیدمان پنل"

msgid "Full-width (Screen wide - Recommended)"
msgstr "تمام‌عرض (گسترده در کل عرض نمایشگر — پیشنهادی)"

msgid "The panel expands across the full screen width and gives your dashboard maximum breathing room without being squeezed by narrow theme containers."
msgstr "پنل در تمام پهنای نمایشگر گسترده می‌شود و فضای کافی برای نمایش بدون فشردگی فراهم می‌کند."

msgid "Boxed (Constrained to theme container)"
msgstr "داخل کادر (محدود به کانتینر قالب)"

msgid "The panel remains confined inside your active WordPress theme content width."
msgstr "پنل درون عرض استاندارد محتوای قالب سایت شما باقی می‌ماند."

msgid "Default theme"
msgstr "تم پیش‌فرض پنل"

msgid "Follow system theme"
msgstr "هماهنگ با تم سیستم"

msgid "Light theme"
msgstr "تم روشن"

msgid "Dark theme"
msgstr "تم تیره"

msgid "Default color mode before user selects their preference in the sidebar."
msgstr "حالت رنگ اولیه پیش از انتخاب ترجیح توسط کاربر در سایدبار."

msgid "Corner radius"
msgstr "انحنای گوشه‌ها"

msgid "Rounded (18px - Modern)"
msgstr "گرد مدرن (۱۸ پیکسل)"

msgid "Smooth (10px)"
msgstr "ملایم (۱۰ پیکسل)"

msgid "Sharp (4px)"
msgstr "تیز و صنعتی (۴ پیکسل)"

msgid "Dashboard stat cards"
msgstr "کارت‌های آماری پیشخوان"

msgid "Show orders count"
msgstr "نمایش تعداد سفارش‌ها"

msgid "Show total spent"
msgstr "نمایش مجموع خرید"

msgid "Show average order"
msgstr "نمایش میانگین سفارش"

msgid "Show downloads count"
msgstr "نمایش تعداد فایل‌های دانلودی"

msgid "Order items thumbnails"
msgstr "پیش‌نمایش کالاهای سفارش"

msgid "Show product images in orders list and invoice"
msgstr "نمایش تصویر بندانگشتی محصولات در جدول سفارشات و فاکتور"

msgid "Tracking URL template"
msgstr "الگوی آدرس رهگیری مرسوله"

msgid "Use %s where the tracking barcode should be inserted. Defaults to Iran Post (https://tracking.post.ir/?id=%s)."
msgstr "از %s در جایی که کد رهگیری قرار می‌گیرد استفاده کنید. پیش‌فرض: سامانه رهگیری پست (https://tracking.post.ir/?id=%s)."

msgid "Panel title"
msgstr "عنوان پنل"

msgid "Welcome word"
msgstr "کلمه‌ی خوش‌آمد"

msgid "Shown before the user name on the dashboard, e.g. Hello."
msgstr "قبل از نام کاربری در پیشخوان نمایش داده می‌شود؛ مثلاً «سلام»."

msgid "Orders per page"
msgstr "تعداد سفارش در هر صفحه"

msgid "My Account integration"
msgstr "یکپارچگی با «حساب کاربری»"

msgid "Replace the WooCommerce My Account area with WooPanel (on by default). Orders, downloads, addresses and account pages all render the panel; theme side-menus are hidden automatically."
msgstr "ناحیه‌ی «حساب کاربری» ووکامرس با ووپنل جایگزین می‌شود (روشن پیش‌فرض). سفارش‌ها، دانلودها، نشانی‌ها و اطلاعات حساب همه با پنل نمایش داده می‌شوند و منوی کناری قالب خودکار پنهان می‌شود."

msgid "Usage"
msgstr "نحوه‌ی استفاده"

msgid "Add this shortcode to any page:"
msgstr "این شورت‌کد را در هر صفحه‌ای قرار دهید:"

msgid "Open a specific view:"
msgstr "باز کردن یک بخش مشخص:"

