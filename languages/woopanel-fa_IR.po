msgstr "ذخیره‌ی اطلاعات"

msgid "Change password"
msgstr "تغییر رمز عبور"

msgid "Current password"
msgstr "رمز عبور فعلی"

msgid "New password"
msgstr "رمز عبور جدید"

msgid "Repeat new password"
msgstr "تکرار رمز عبور جدید"

msgid "Your address has been saved."
msgstr "نشانی شما ذخیره شد."

msgid "Your account details have been saved."
msgstr "اطلاعات حساب شما ذخیره شد."

msgid "Your password has been changed."
msgstr "رمز عبور شما تغییر کرد."

msgid "Please enter a valid email address that is not already in use."
msgstr "لطفاً یک ایمیل معتبر وارد کنید که قبلاً استفاده نشده باشد."

msgid "New password and confirmation do not match."
msgstr "رمز جدید و تکرار آن یکسان نیستند."

msgid "New password must be at least 8 characters long."
msgstr "رمز عبور جدید باید حداقل ۸ نویسه باشد."

msgid "Your current password is not correct."
msgstr "رمز عبور فعلی نادرست است."

msgid "The address could not be saved. Please check the form and try again."
msgstr "ذخیره‌ی نشانی ممکن نشد. لطفاً فرم را بررسی و دوباره تلاش کنید."

msgid "Your session expired or the form was invalid. Please try again."
msgstr "نشست شما منقضی شده یا فرم نامعتبر است. لطفاً دوباره تلاش کنید."
